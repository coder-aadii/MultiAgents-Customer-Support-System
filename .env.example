# MCSS Environment Configuration
# Copy to .env and fill in values. Never commit .env

# Application
MCSS_ENV=development
MCSS_API_HOST=0.0.0.0
MCSS_API_PORT=8000

# Database
# PostgreSQL 16 + pgvector, host port 55432, internal port 5432
MCSS_DATABASE_URL=postgresql+psycopg://mcss:change-me@postgres:5432/mcss

# Redis, Celery, and real-time messaging
MCSS_REDIS_URL=redis://redis:6379/0
MCSS_CELERY_BROKER_URL=redis://redis:6379/1
MCSS_CELERY_RESULT_BACKEND=redis://redis:6379/2
MCSS_WUKONGIM_API_URL=http://wukongim:5001
MCSS_WUKONGIM_WS_URL=ws://localhost:5200
MCSS_WUKONGIM_SYSTEM_UID=mcss-system

# Authentication
# Must be at least 32 random characters in production
MCSS_JWT_SECRET=replace-with-at-least-32-random-characters
MCSS_JWT_ACCESS_MINUTES=15
MCSS_JWT_REFRESH_DAYS=7

# CORS
# Comma-separated list of allowed origins for admin and widget
MCSS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Widget
# Allowed origin for widget session creation (required in production)
MCSS_WIDGET_ALLOWED_ORIGIN=http://localhost:5174

# LLM Provider (OpenAI-compatible Chat Completions API)
# Set to "fake" to use the fake test provider without paid credentials
MCSS_LLM_BASE_URL=https://api.example.com/v1
MCSS_LLM_API_KEY=replace-me
MCSS_LLM_CHAT_MODEL=replace-me

# Embeddings
MCSS_EMBEDDING_MODEL=replace-me
MCSS_EMBEDDING_DIMENSIONS=1536

# Retrieval
MCSS_RETRIEVAL_MIN_SCORE=0.72

# Phase 6 multi-agent orchestration
# Enable orchestration and durable workflow together; keep all flags false until
# migrations 0014/0015 and the required release verification are complete.
MCSS_MULTI_AGENT_ORCHESTRATION_ENABLED=false
MCSS_MULTI_AGENT_WORKFLOW_ENABLED=false
MCSS_DYNAMIC_TOOL_CALLING_ENABLED=false
MCSS_REFLECTION_ENABLED=false
MCSS_REFLECTION_MAX_REVISIONS=1
MCSS_REFLECTION_MAX_SUPPLEMENTAL_INVESTIGATIONS=1
MCSS_REFLECTION_TIMEOUT_SECONDS=5.0

# Admin bootstrap (used by scripts/seed-admin.py)
MCSS_ADMIN_EMAIL=admin@example.com
MCSS_ADMIN_PASSWORD=replace-me
